# Postgres connection string used by Prisma (see prisma.config.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/fundsroom

# --- API server ---
PORT=4000
NODE_ENV=development

# Secret used to sign/verify JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins; omit for *
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
