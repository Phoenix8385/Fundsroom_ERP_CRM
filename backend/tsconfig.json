{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment settings
    // NOTE: moduleResolution is deliberately left unset so it defaults from
    // "module": "commonjs". Pinning it to "node" breaks on newer TypeScript.
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],

    // Interop
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Other outputs
    "sourceMap": true,
    "declaration": false,

    // Type checking
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
